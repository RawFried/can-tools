{
  "name": "can-tools-web",
  "private": true,
  "version": "0.4.6",
  "description": "CAN Tools 前端（TypeScript / CSS / HTML 片段源码；编译产物 index.html / app.js / app.css 由 Rust 后端嵌入并分发）",
  "scripts": {
    "build": "npm run build:html && npm run build:js && npm run build:css",
    "build:html": "node scripts/build-html.mjs",
    "build:js": "esbuild src/main.ts --bundle --format=iife --target=es2021 --charset=utf8 --legal-comments=none --log-level=warning --outfile=app.js",
    "build:css": "esbuild src/styles/index.css --bundle --charset=utf8 --log-level=warning --outfile=app.css",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:dbc-model && npm run test:chart-math",
    "test:dbc-model": "esbuild test/dbc-model.test.ts --bundle --format=iife --platform=node --log-level=warning --outfile=../target/web-tests/dbc-model.test.js && node ../target/web-tests/dbc-model.test.js",
    "test:chart-math": "esbuild test/chart-math.test.ts --bundle --format=iife --platform=node --log-level=warning --outfile=../target/web-tests/chart-math.test.js && node ../target/web-tests/chart-math.test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
