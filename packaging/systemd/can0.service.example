# 示例：开机把 can0 配置为 500 kbps 并 UP（restart-ms 让 bus-off 自动恢复）。
# 用法:
#   sudo cp packaging/systemd/can0.service.example /etc/systemd/system/can0.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now can0.service
[Unit]
Description=Configure can0 (PCAN)
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in $(seq 1 100); do [ -e /sys/class/net/can0 ] && exec /sbin/ip link set can0 type can bitrate 500000 restart-ms 100 up; sleep 0.2; done; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
